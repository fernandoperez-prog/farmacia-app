<%- include('partials/header') %>
<h3 class="mb-1">Bienvenido, <%= user.username %></h3>
<p class="text-muted">Tu rol es <b><%= user.role %></b>.
  <% if (user.role === 'admin') { %>Puedes crear, editar y eliminar registros y administrar usuarios.
  <% } else if (user.role === 'moderator') { %>Puedes crear y editar registros.
  <% } else { %>Solo puedes consultar la información.<% } %>
</p>
<div class="row g-3">
  <div class="col-md-4">
    <a href="/medicamentos" class="text-decoration-none">
      <div class="card menu-card h-100 text-center p-4">
        <i class="bi bi-capsule fs-1 text-primary"></i>
        <h5 class="mt-2">Medicamentos</h5>
        <small class="text-muted">Tabla Medicamento</small>
      </div>
    </a>
  </div>
  <div class="col-md-4">
    <a href="/tipos" class="text-decoration-none">
      <div class="card menu-card h-100 text-center p-4">
        <i class="bi bi-tags fs-1 text-primary"></i>
        <h5 class="mt-2">Tipos de medicamento</h5>
        <small class="text-muted">Tabla TipoMedic</small>
      </div>
    </a>
  </div>
  <% if (user.role === 'admin') { %>
  <div class="col-md-4">
    <a href="/usuarios" class="text-decoration-none">
      <div class="card menu-card h-100 text-center p-4">
        <i class="bi bi-people fs-1 text-primary"></i>
        <h5 class="mt-2">Usuarios</h5>
        <small class="text-muted">Solo administrador</small>
      </div>
    </a>
  </div>
  <% } %>
</div>
<%- include('partials/footer') %>
